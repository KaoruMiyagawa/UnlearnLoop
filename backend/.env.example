# UnlearnLoop Backend 环境变量配置样例
# 复制此文件为 backend/.env（或在项目根目录放置 .env），切勿提交真实密钥

APP_NAME=UnlearnLoop
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18000
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:5173,http://127.0.0.1:5173

# 数据库配置（SQLite + SQLAlchemy 预留）
DATABASE_URL=sqlite:///./unlearnloop.db

# AI 模型服务配置预留（Stage 3 启用）
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
ALLOW_REMOTE_MODEL_CALLS=false
