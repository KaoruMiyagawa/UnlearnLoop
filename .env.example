# VerbaTrail 环境变量配置样例
# 复制此文件为 .env 并按需修改本地配置，切勿将真实密钥提交到版本控制

# 应用基础配置
APP_NAME=VerbaTrail
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18000
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:5173,http://127.0.0.1:5173

# 数据库配置（SQLite 本地持久化预留）
DATABASE_URL=sqlite:///./unlearnloop.db

# AI 模型服务配置预留（Stage 3 接入 DeepSeek / Ollama，切勿在此填写明文密钥）
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS_PER_CALL=1024
MODEL_TEMPERATURE=0.1
ALLOW_REMOTE_MODEL_CALLS=false

# Agent 诊断循环与预算限制（Stage 3）
MAX_DIAGNOSTIC_FOLLOWUP_TURNS=2
DIAGNOSTIC_SESSION_TOKEN_BUDGET=4096

# 前端开发服务配置
VITE_API_BASE_URL=http://127.0.0.1:18000
